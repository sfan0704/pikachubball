// Each checkout (worktree, clone, CI job) gets its own local Supabase stack and
// ports, derived from its absolute path, so two workspaces on one Docker host
// never reset or reuse each other's state. The tracked supabase/config.toml is
// untouched: the stack runs from a generated, git-ignored copy in .workspace/.
//
//   node scripts/workspace.mts           prints the identity and ports
//   node scripts/workspace.mts --shell   prints `export NAME=value` lines and
//                                        writes .workspace/supabase/
import { createHash } from "node:crypto";
import { existsSync, mkdirSync, readFileSync, rmSync, symlinkSync, writeFileSync } from "node:fs";
import { dirname, join, relative, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), "..");
const SLOTS = 100;

/** A checkout's stack name, generated Supabase folder and ports. */
export interface Workspace {
  readonly root: string;
  readonly id: string;
  readonly slot: number;
  readonly projectId: string;
  readonly workdir: string;
  readonly ports: Readonly<Record<PortName, number>>;
}

type PortName =
  | "supabaseShadow"
  | "supabaseApi"
  | "supabaseDb"
  | "supabaseStudio"
  | "supabaseMail"
  | "supabaseSmtp"
  | "supabasePop3"
  | "supabaseAnalytics"
  | "supabasePooler"
  | "supabaseInspector"
  | "dev"
  | "browser"
  | "load"
  | "review"
  | "devStandIn"
  | "browserStandIn"
  | "loadStandIn"
  | "reviewStandIn";

/** The identity, stack name and ports of the checkout this file lives in. */
export function workspace(root: string = ROOT): Workspace {
  const id = createHash("sha256").update(resolve(root)).digest("hex").slice(0, 8);
  const slot = Number.parseInt(id.slice(0, 4), 16) % SLOTS;
  // Supabase ports in 40000–41999; app and stand-in ports in 20000–20999.
  // Both ranges avoid the ports browsers refuse and the usual defaults.
  const supabase = 40000 + slot * 20;
  const app = 20000 + slot * 10;
  return {
    root,
    id,
    slot,
    projectId: `pikachubball-${id}`,
    workdir: join(root, ".workspace"),
    ports: {
      supabaseShadow: supabase,
      supabaseApi: supabase + 1,
      supabaseDb: supabase + 2,
      supabaseStudio: supabase + 3,
      supabaseMail: supabase + 4,
      supabaseSmtp: supabase + 5,
      supabasePop3: supabase + 6,
      supabaseAnalytics: supabase + 7,
      supabasePooler: supabase + 8,
      supabaseInspector: supabase + 9,
      dev: app,
      browser: app + 1,
      load: app + 2,
      review: app + 3,
      devStandIn: app + 5,
      browserStandIn: app + 6,
      loadStandIn: app + 7,
      reviewStandIn: app + 8,
    },
  };
}

/** Port settings for the generated config, by TOML table. */
function portTables({ ports }: Workspace): Record<string, Record<string, number>> {
  return {
    api: { port: ports.supabaseApi },
    db: { port: ports.supabaseDb, shadow_port: ports.supabaseShadow },
    "db.pooler": { port: ports.supabasePooler },
    studio: { port: ports.supabaseStudio },
    inbucket: {
      port: ports.supabaseMail,
      smtp_port: ports.supabaseSmtp,
      pop3_port: ports.supabasePop3,
    },
    analytics: { port: ports.supabaseAnalytics },
    edge_runtime: { inspector_port: ports.supabaseInspector },
  };
}

/** The tracked config with this workspace's stack name and ports put in. */
export function workspaceConfig(ws: Workspace, tracked: string): string {
  const tables = portTables(ws);
  const seen = new Set<string>();
  const lines: string[] = [];
  for (const line of tracked.split("\n")) {
    if (/^project_id\s*=/.test(line)) {
      lines.push(`project_id = "${ws.projectId}"`);
      continue;
    }
    lines.push(line);
    const table = /^\[([^\]]+)\]\s*$/.exec(line)?.[1];
    const values = table ? tables[table] : undefined;
    if (table && values) {
      seen.add(table);
      for (const [key, value] of Object.entries(values)) lines.push(`${key} = ${value}`);
    }
  }
  for (const [table, values] of Object.entries(tables)) {
    if (seen.has(table)) continue;
    lines.push(
      "",
      `[${table}]`,
      ...Object.entries(values).map(([key, value]) => `${key} = ${value}`)
    );
  }
  return `# Generated by scripts/workspace.mts for ${ws.root}. Do not edit.\n${lines.join("\n")}\n`;
}

/** Writes .workspace/supabase: the generated config plus a link to the tracked migrations. */
export function writeWorkspaceStack(ws: Workspace): void {
  const target = join(ws.workdir, "supabase");
  mkdirSync(target, { recursive: true });
  const tracked = readFileSync(join(ws.root, "supabase", "config.toml"), "utf8");
  writeFileSync(join(target, "config.toml"), workspaceConfig(ws, tracked));
  // Tests aren't linked: test-database.sh passes the real folder, which a container mounts.
  const link = join(target, "migrations");
  rmSync(link, { force: true, recursive: false });
  symlinkSync(relative(target, join(ws.root, "supabase", "migrations")), link);
  rmSync(join(target, "tests"), { force: true, recursive: false });
}

function shellExports(ws: Workspace): string {
  const values = {
    WORKSPACE_ID: ws.id,
    WORKSPACE_PROJECT_ID: ws.projectId,
    WORKSPACE_SUPABASE_DIR: ws.workdir,
    WORKSPACE_SUPABASE_API_PORT: ws.ports.supabaseApi,
    WORKSPACE_SUPABASE_DB_PORT: ws.ports.supabaseDb,
    WORKSPACE_DEV_PORT: ws.ports.dev,
    WORKSPACE_DEV_STANDIN_PORT: ws.ports.devStandIn,
    WORKSPACE_BROWSER_PORT: ws.ports.browser,
    WORKSPACE_BROWSER_STANDIN_PORT: ws.ports.browserStandIn,
    WORKSPACE_LOAD_PORT: ws.ports.load,
    WORKSPACE_LOAD_STANDIN_PORT: ws.ports.loadStandIn,
  };
  return Object.entries(values)
    .map(([name, value]) => `export ${name}='${String(value).replace(/'/g, "'\\''")}'`)
    .join("\n");
}

if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
  const ws = workspace();
  if (process.argv.includes("--shell")) {
    writeWorkspaceStack(ws);
    console.log(shellExports(ws));
  } else {
    console.log(JSON.stringify({ ...ws, stackExists: existsSync(ws.workdir) }, null, 2));
  }
}
