{
  "name": "rest-express",
  "version": "1.0.0",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "type": "commonjs",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development node -r dotenv/config node_modules/.bin/tsx --watch server/index.ts dotenv_config_path=.env.local",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist --out-extension:.js=.mjs",
    "start": "NODE_ENV=production node dist/index.mjs",
    "check": "tsc",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:db": "bash scripts/test-database.sh"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.25",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
