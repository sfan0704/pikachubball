{
  "name": "rest-express",
  "version": "1.0.0",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "type": "commonjs",
  "license": "MIT",
  "scripts": {
    "dev": "bash scripts/dev-local.sh",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist --out-extension:.js=.mjs",
    "start": "NODE_ENV=production node dist/index.mjs",
    "check": "tsc",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage && node scripts/coverage-floor.mts",
    "standin": "tsx scripts/yahoo-standin.ts",
    "capture:yahoo": "tsx scripts/capture-yahoo.ts",
    "capture:yahoo-game-log": "tsx scripts/capture-yahoo-game-log.ts",
    "capture:yahoo-live-calls": "tsx scripts/capture-yahoo-live-calls.ts",
    "capture:yahoo-research": "tsx scripts/capture-yahoo-research.ts",
    "capture:yahoo-stat-categories": "tsx scripts/capture-yahoo-stat-categories.ts",
    "capture:yahoo-week": "tsx scripts/capture-yahoo-week.ts",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "load": "bash scripts/load-test.sh",
    "test:browser": "playwright test",
    "test:db": "bash scripts/test-database.sh",
    "workspace": "node scripts/workspace.mts",
    "stack:stop": "bash scripts/stack-stop.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "agent:setup": "node scripts/agent-setup.mts",
    "session:setup": "node scripts/session-setup.mts",
    "validate": "node scripts/validate.mts",
    "doctor": "node scripts/doctor.mts",
    "review:start": "node scripts/review.mts start",
    "review:status": "node scripts/review.mts status",
    "review:stop": "node scripts/review.mts stop",
    "review:evidence": "playwright test -c playwright.review.config.mts",
    "config:check": "node scripts/config-check/cli.mts",
    "config:baseline": "node scripts/config-check/baseline.mts",
    "config:capture": "node scripts/config-check/capture.mts",
    "release:drift": "bash scripts/release/drift-check.sh",
    "release:migrate": "node scripts/release/migrate.mts",
    "release:config": "node scripts/release/config-cli.mts",
    "check:migrations": "node scripts/release/migration-order.mts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "@tanstack/react-query": "^5.108.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "1.0.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "lucide-react": "^1.78.0",
    "nanoid": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "wouter": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/express": "4.17.21",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.13",
    "axe-core": "^4.14.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "happy-dom": "^21.0.4",
    "knip": "6.48.0",
    "msw": "^2.12.2",
    "pg": "8.23.1",
    "postcss": "^8.5.33",
    "prettier": "3.10.1",
    "supabase": "2.117.0",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.0.13"
  },
  "optionalDependencies": {
    "bufferutil": "^4.2.0"
  }
}
