# Dev tier: copy to .env.local and fill in the placeholders.
#   cp .env.example .env.local
# Values come from the DEV resources only (see README "Environments"):
#   Supabase project "Pikachu Basketball Development" and its Yahoo app.
# Never put production values here; production secrets live only in Vercel.

NODE_ENV=development

# macOS AirPlay Receiver listens on 5000, so local dev uses 5001. HTTPS is
# optional (mkcert, see README); the dev Supabase URL configuration must match.
PORT=5001
APP_ORIGIN=https://localhost:5001

# Supabase > Project Settings > API (dev project). Publishable key only; never a
# secret or service-role key.
SUPABASE_URL=https://ocqdxmfpezxpgutoicyh.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me

# 64 hex characters, unique to this environment: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-characters

# The same Yahoo app as the dev Supabase custom:yahoo provider (server-only; used
# for token refresh). Today that is "PikachuBball", the only Fantasy-activated app.
YAHOO_CLIENT_ID=replace-me
YAHOO_CLIENT_SECRET=replace-me
# Sent as redirect_uri when refreshing Yahoo tokens (verified 2026-09-24).
YAHOO_PROVIDER_REDIRECT_URI=https://localhost:5001/api/auth/yahoo/fantasy/callback

# Local HTTPS certificate from mkcert (gitignored).
DEV_HTTPS_CERT=.certs/localhost.pem
DEV_HTTPS_KEY=.certs/localhost-key.pem
